{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "cdx-resident-trio88-green",
    "namespace": "codex-resident-delivery-20261102",
    "labels": {
      "owner": "codex",
      "experiment": "trio88-build"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 900,
    "ttlSecondsAfterFinished": 900,
    "template": {
      "metadata": {
        "labels": {
          "owner": "codex",
          "experiment": "resident-delivery-build"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "etri-001"
        },
        "containers": [
          {
            "name": "build",
            "image": "golang@sha256:c423747fbd96fd8f0b1102d947f51f9b266060217478e5f9bf86f145969562ee",
            "imagePullPolicy": "IfNotPresent",
            "workingDir": "/work/onggi-source",
            "command": [
              "sh",
              "-c",
              "set -eu\nmkdir /work/trio88-green/evidence\ngo version > /work/trio88-green/evidence/go-version.txt\nset +e\ngo test -mod=readonly -race -count=1 -v /work/trio88-green/three_arm_call.go /work/trio88-green/three_arm_call_test.go > /work/trio88-green/evidence/tests.log 2>&1\nrc=$?\nset -e\nprintf '%s\n' \"$rc\" > /work/trio88-green/evidence/test-exit.txt\ncat /work/trio88-green/evidence/tests.log\ntest \"$rc\" -eq 0\ngofmt -d /work/trio88-green/three_arm_call.go /work/trio88-green/three_arm_call_test.go > /work/trio88-green/evidence/gofmt.diff\ngo vet /work/trio88-green/three_arm_call.go > /work/trio88-green/evidence/vet.log 2>&1\nCGO_ENABLED=0 go build -trimpath -mod=readonly -o /work/trio88-green/three-arm-call /work/trio88-green/three_arm_call.go > /work/trio88-green/evidence/build.log 2>&1\nsha256sum /work/trio88-green/three-arm-call > /work/trio88-green/evidence/binary-sha256.txt\necho completed > /work/trio88-green/evidence/status.txt\n"
            ],
            "env": [
              {
                "name": "GOCACHE",
                "value": "/work/trio88-go-cache"
              },
              {
                "name": "GOMODCACHE",
                "value": "/work/go-mod"
              },
              {
                "name": "GOPROXY",
                "value": "off"
              },
              {
                "name": "GOSUMDB",
                "value": "off"
              },
              {
                "name": "GOTOOLCHAIN",
                "value": "local"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "limits": {
                "cpu": "8",
                "memory": "16Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsNonRoot": true,
              "runAsUser": 1002,
              "runAsGroup": 1002,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumeMounts": [
              {
                "name": "work",
                "mountPath": "/work"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "work",
            "hostPath": {
              "path": "/home/gspark/workspace/codex_resident_delivery_20261102",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}
